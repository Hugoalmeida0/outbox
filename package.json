{
  "name": "camaleao",
  "version": "1.0.0",
  "private": true,
  "description": "Camaleão: candidatura assistida com currículo camaleão, pela CLI ou pelo site",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/web"
  ],
  "bin": {
    "camaleao": "bin/camaleao.js"
  },
  "imports": {
    "#dominio/*": "./src/dominio/*",
    "#aplicacao/*": "./src/aplicacao/*",
    "#infra/*": "./src/infra/*",
    "#interfaces/*": "./src/interfaces/*",
    "#composicao": "./src/composicao.ts",
    "#testes/*": "./tests/*",
    "#scripts/*": "./scripts/*"
  },
  "scripts": {
    "camaleao": "node bin/camaleao.js",
    "test": "vitest run",
    "lint": "eslint .",
    "formatar": "prettier --write .",
    "tipos": "tsc --noEmit",
    "verificar": "npm run tipos && npm run lint && prettier --check . && npm run -w apps/web tipos && npm run -w apps/web lint && npm run -w apps/web build && npm run -w apps/web test && vitest run --coverage && npm audit --omit=dev --audit-level=high",
    "capturar-fixture": "node scripts/capturar-fixture.ts",
    "web": "npm run -w apps/web dev"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@inquirer/prompts": "8.7.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/mcp": "0.0.83",
    "commander": "15.0.0",
    "cross-spawn": "7.0.6",
    "hono": "4.13.13",
    "mammoth": "1.13.0",
    "node-notifier": "10.0.1",
    "open": "11.0.4",
    "playwright": "1.64.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "1.0.10",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "26.6.5",
    "@types/node-notifier": "8.0.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
